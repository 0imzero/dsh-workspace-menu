{
  "name": "@dsh-external/dsh-workspace-menu",
  "version": "2.0.3",
  "description": "DSH 主页工作区/会话右键与双击增强菜单：置顶、重命名、资源管理器打开、归档、分叉、复制、新窗口等（DSH 0.2.x 适配版）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0imzero/dsh-workspace-menu.git"
  },
  "homepage": "https://github.com/0imzero/dsh-workspace-menu#readme",
  "bugs": "https://github.com/0imzero/dsh-workspace-menu/issues",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "cordis": ">=4.0.0-rc <5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "npm run build:host && npm run build:types && npm run build:client && node scripts/check.mjs",
    "build:host": "tsc -p tsconfig.host.json",
    "build:types": "tsc -p tsconfig.client.types.json",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json",
    "check": "node scripts/check.mjs",
    "test": "node scripts/test-routes.mjs && node --experimental-strip-types scripts/test-delete-flow.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
